{
  "manifest_version": 3,
  "name": "Gamblock AI - Web Protection",
  "version": "1.0.0",
  "description": "DOM sensor for Gamblock AI. Reads page content and forwards to local AI classifier via WebSocket.",
  "permissions": ["activeTab", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
